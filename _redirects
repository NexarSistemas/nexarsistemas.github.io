# Juegos Nexar: el dominio principal lo sirve Netlify.

# Tetris se sirve localmente desde este mismo deploy para evitar bucles
# entre Netlify y el dominio personalizado histórico de GitHub Pages.
/Tetris               /Tetris/                                                   301
/tetris               /Tetris/                                                   301
/tetris/*             /Tetris/:splat                                             301

# Crucigrama se mantiene aislado del origen del portal de vendedores.
# La redirección envía al usuario a la producción segura de Vercel.
/nexar-crucigrama     https://nexar-crucigrama.vercel.app/                       302
/nexar-crucigrama/*   https://nexar-crucigrama.vercel.app/:splat                 302
